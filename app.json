{
  "expo": {
    "name": "TravelThings",
    "slug": "travelthings",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "travelthings",
    "userInterfaceStyle": "light",
    "backgroundColor": "#f2f2f7",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.eitankoren.travelthings",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIFileSharingEnabled": false,
        "LSSupportsOpeningDocumentsInPlace": false
      },
      "entitlements": {
        "com.apple.developer.default-data-protection": "NSFileProtectionComplete"
      }
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "TravelThings needs access to your photos so you can save tickets and screenshots.",
          "cameraPermission": "TravelThings needs the camera so you can photograph a document."
        }
      ],
      "expo-document-picker",
      [
        "react-native-document-scanner-plugin",
        {
          "cameraPermission": "TravelThings needs the camera to scan paper documents."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "platforms": [
      "ios"
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "5e7c7a30-4616-4946-b632-b0d3e7c38aae"
      }
    }
  }
}
