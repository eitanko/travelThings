{
  "expo": {
    "name": "Travel Things",
    "slug": "travelthings",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "travelthings",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#f2f2f7",
    "newArchEnabled": true,
    "icon": "./assets/icon/icon-light.png",
    "ios": {
      "icon": {
        "light": "./assets/icon/icon-light.png",
        "dark": "./assets/icon/icon-dark.png",
        "tinted": "./assets/icon/icon-tinted.png"
      },
      "userInterfaceStyle": "automatic",
      "supportsTablet": false,
      "bundleIdentifier": "com.eitankoren.travelthings",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIFileSharingEnabled": false,
        "LSSupportsOpeningDocumentsInPlace": false
      },
      "entitlements": {
        "com.apple.developer.default-data-protection": "NSFileProtectionComplete",
        "com.apple.security.application-groups": [
          "group.com.eitankoren.travelthings"
        ]
      },
      "runtimeVersion": {
        "policy": "appVersion"
      }
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "Travel Things needs access to your photos so you can save tickets and screenshots.",
          "cameraPermission": "Travel Things needs the camera so you can photograph a document."
        }
      ],
      "expo-document-picker",
      [
        "react-native-document-scanner-plugin",
        {
          "cameraPermission": "Travel Things needs the camera to scan paper documents."
        }
      ],
      [
        "./plugins/withShareExtension",
        {
          "groupId": "group.com.eitankoren.travelthings"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "platforms": [
      "ios"
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "5e7c7a30-4616-4946-b632-b0d3e7c38aae"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/5e7c7a30-4616-4946-b632-b0d3e7c38aae"
    },
    "android": {
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    }
  }
}
